# UAT/Staging Environment Configuration

# Database
DB_HOST=localhost
DB_NAME=your_uat_database
DB_USER=your_uat_user
DB_PASS=your_uat_password
DB_CHARSET=utf8mb4

# Application
APP_ENV=production
# Leave APP_URL commented out to auto-detect from server
# Or set explicitly: APP_URL=https://uat.yourdomain.com
BASE_PATH=

# Session
SESSION_LIFETIME=1800
CSRF_TOKEN_NAME=csrf_token

# Upload
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Notes:
# - APP_URL will auto-detect the domain if not set
# - BASE_PATH should be empty if site is in root directory
# - Change APP_ENV to 'development' only for debugging
